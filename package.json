{
  "name": "mochi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "check": "npm run test && npm run typecheck && npm run build",
    "start": "node dist/main.js",
    "start:admin": "node dist/admin-main.js"
  },
  "dependencies": {
    "@azure/identity": "4.13.2",
    "@azure/msal-browser": "5.21.0",
    "@azure/storage-queue": "12.31.0",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
